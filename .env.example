# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Must be a long random string (at least 32 characters in production)
JWT_SECRET=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=biztrack
DB_USER=postgres
DB_PASSWORD=

# API docs at /api-docs. Defaults to true, except in production (false).
# DOCS_ENABLED=true

# Browser origins allowed to call the API, comma separated, no trailing slash.
# Default: http://localhost:5173,http://localhost:3000 (none in production).
# CORS_ORIGINS=http://localhost:5173

# Requests allowed per IP address every 15 minutes on /api (default 300).
# RATE_LIMIT_MAX=300
